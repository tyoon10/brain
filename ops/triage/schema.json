{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyoon10/brain/ops/triage/schema.json",
  "title": "Luna triage decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "lane",
    "category",
    "confidence",
    "reasons",
    "matchedKeywords",
    "failedChecks",
    "draft"
  ],
  "properties": {
    "decision": { "type": "string", "enum": ["include", "exclude", "hold"] },
    "lane": { "type": "string", "enum": ["industry", "featured-event"] },
    "category": {
      "type": ["string", "null"],
      "enum": ["release", "acquisition", "investment", "partnership", null]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "matchedKeywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failedChecks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "summary"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string" },
        "startsAt": { "type": "string" },
        "location": { "type": "string" },
        "href": { "type": "string" },
        "inferred": { "type": "boolean" },
        "held": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "lane": { "type": "string" },
        "category": { "type": ["string", "null"] }
      }
    }
  }
}
