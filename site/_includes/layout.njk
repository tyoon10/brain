<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.publicName }}{% else %}{{ site.publicName }} · {{ site.legalName }}{% endif %}</title>
    <meta name="description" content="{{ description or site.expansion }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="/css/preview.css" />
    <style>
      {% for seat in programs %}
      [data-seat="{{ seat.id }}"] { background-color: {{ seat.colour }}; }
      {% endfor %}
    </style>
  </head>
  <body class="{{ bodyClass }}">
    <a class="skip" href="#content">Skip to content</a>
    <header class="mast">
      <a class="brand" href="/">
        <span class="wordmark-public">{{ site.publicName }}</span>
        <span class="wordmark-legal">{{ site.legalName }}</span>
      </a>
      <nav aria-label="{{ site.publicName }}">
        {% for item in site.nav %}
        <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
    </header>
    <main id="content">
      {{ content | safe }}
    </main>
    <footer class="colophon">
      <div>
        <p>{{ site.legalName }} · {{ site.expansion }} · The door is free.</p>
        <p class="ia-strip">
          <a href="/">Enter</a>
          <a href="/room/">Room</a>
          <a href="/map/">Map</a>
          <a href="/table/">Table</a>
          <a href="/sitemap/">Atlas</a>
          <a href="/docket/">Docket</a>
          <a href="/offer-book/">Offer book</a>
          <a href="/brief/">Brief</a>
          <a href="/newsletter/">Newsletter</a>
          <a href="/benefits/">Benefits</a>
          <a href="/programs/">Programs</a>
          <a href="/labs/">Labs</a>
          <a href="/freshness/">Freshness</a>
          <a href="/seats/">Seats</a>
          <a href="/door/">Door</a>
        </p>
      </div>
      <p><a href="/sitemap/">44 pages · 12 sections</a></p>
    </footer>
  </body>
</html>
