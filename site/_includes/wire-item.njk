<article class="wire-item{% if item.held %} wire-held{% endif %}">
  <p class="meta">
    <time datetime="{{ item.publishedAt | isoDay }}">{{ item.publishedAt | isoDay }}</time>
    {% if item.category %}<span class="chip chip-{{ item.category }}">{{ item.category | categoryLabel }}</span>{% endif %}
    {% if item.held %}<span class="chip chip-held">Held</span>{% endif %}
    {% if item.inferred %}<span class="chip chip-inferred">Inferred</span>{% endif %}
  </p>
  <h3>
    {% if item.slug | hasBriefPage %}
    <a href="/brief/{{ item.slug }}/">{{ item.title }}</a>
    {% else %}
    {{ item.title }}
    {% endif %}
  </h3>
  <p>{{ item.summary }}</p>
  {% if showNotes and item.inferredNote %}<p class="inferred">{{ item.inferredNote }}</p>{% endif %}
  {% if showSource and item.href %}<p><a class="text-link" href="{{ item.href }}">Source</a></p>{% endif %}
</article>
