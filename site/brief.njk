---
layout: layout.njk
title: Brief
description: The Roundtable wire.
permalink: /brief/index.html
---

<p class="kicker">The wire</p>
<h1>Brief</h1>
<p class="lede">Information is the service. Briefs are posted here as they are written.</p>

{% if wire.length == 0 %}
  {% set emptyTitle = "The wire is quiet." %}
  {% set emptyBody = "When a brief is ready, it is added to the public wire files and listed here." %}
  {% include "empty.njk" %}
{% else %}
  <ul class="register">
    {% for item in wire %}
    <li>
      <p class="meta">{{ item.publishedAt | nyDate }}</p>
      <h2>{{ item.title }}</h2>
      <p>{{ item.summary }}</p>
      {% if item.inferred %}<p class="inferred">Inferred{% if item.inferredNote %} · {{ item.inferredNote }}{% endif %}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
{% endif %}
