---
layout: layout.njk
title: Brief
description: Twenty posts on two lanes. GLM version held.
permalink: /brief/index.html
eleventyNavigation:
  key: Brief
  order: 60
bodyClass: page-brief
---
<header class="page-hero">
  <p class="kicker">Brief · twenty posts · two lanes</p>
  <h1>Industry on the left. Campus on the right.</h1>
  <p class="lede">GLM version held. Reported figures stay reported. Terms undisclosed stay undisclosed.</p>
</header>
<div class="wire">
  <section>
    <h2>Industry · {{ industryWire.length }}</h2>
    {% for item in industryWire %}
    <article class="wire-item{% if item.held %} wire-held{% endif %}">
      <p class="meta">
        <time datetime="{{ item.publishedAt | isoDay }}">{{ item.publishedAt | isoDay }}</time>
        {% if item.held %}<span class="chip chip-held">Held</span>{% endif %}
        {% if item.inferred %}<span class="chip chip-inferred">Inferred</span>{% endif %}
      </p>
      <h3>
        {% if item.slug | hasBriefPage %}
        <a href="/brief/{{ item.slug }}/">{{ item.title }}</a>
        {% else %}
        {{ item.title }}
        {% endif %}
      </h3>
      <p>{{ item.summary }}</p>
      {% if item.inferredNote %}<p class="inferred">{{ item.inferredNote }}</p>{% endif %}
    </article>
    {% endfor %}
  </section>
  <section>
    <h2>Campus · {{ campusWire.length }}</h2>
    {% for item in campusWire %}
    <article class="wire-item">
      <p class="meta"><time datetime="{{ item.publishedAt | isoDay }}">{{ item.publishedAt | isoDay }}</time></p>
      <h3>{{ item.title }}</h3>
      <p>{{ item.summary }}</p>
    </article>
    {% endfor %}
  </section>
</div>
