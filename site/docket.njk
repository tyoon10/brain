---
layout: layout.njk
title: Docket
description: Upcoming empty, past board populated with eleven sittings.
section: Docket
permalink: /docket/index.html
bodyClass: page-docket
---

<div class="deck">
  <header class="span-12 page-hero">
    <p class="kicker">Sittings · 30 Sep 2025 → 5 Aug 2026</p>
    <h1>Docket</h1>
    <p class="lede">Eleven sittings sat. Owned, co-hosted, and listed are distinct. Register links out. Eligibility inferred is marked inferred.</p>
  </header>

  <section class="deck-sittings" aria-labelledby="past-heading">
    <div class="section-head">
      <h2 id="past-heading">Sat · <span class="tabular">{{ pastSittings.length }}</span></h2>
      <p class="legend">
        <span class="chip chip-owned">Owned</span>
        <span class="chip chip-co-hosted">Co-hosted</span>
        <span class="chip chip-listed">Listed</span>
        <span class="chip chip-inferred">Eligibility inferred</span>
      </p>
    </div>
    <div class="board board--dense">
      {% for sitting in pastSittings %}
        {% include "sitting.njk" %}
      {% endfor %}
    </div>
  </section>

  <aside class="deck-rail">
    <h2 id="upcoming-heading">Upcoming</h2>
    {% if upcomingSittings.length == 0 %}
      {% set emptyTitle = "No sitting is on the docket yet." %}
      {% set emptyBody = "Upcoming always resolves. When a sitting is dated, it is listed here." %}
      {% include "empty.njk" %}
    {% else %}
      <div class="board">
        {% for sitting in upcomingSittings %}
          {% include "sitting.njk" %}
        {% endfor %}
      </div>
    {% endif %}
    <p><a class="text-link" href="/docket/upcoming/">Upcoming as its own page</a></p>
  </aside>
</div>
