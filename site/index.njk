---
layout: layout.njk
description: Three homepage directions. None is locked. The past board, offer book, and brief are on the table.
section: Enter
bodyClass: page-home
---

<div class="deck">
  <header class="deck-intro">
    <div>
      <p class="kicker">{{ site.expansion }}</p>
      <h1>Roundtable</h1>
      <p class="lede">{{ site.productLine }} Question 12 is open.</p>
      <p class="yale">{{ site.yaleLine }}</p>
      <p class="door">{{ site.doorLine }}</p>
    </div>
    <nav class="direction-strip" aria-label="Homepage directions">
      <a href="/room/">
        <p class="kicker">Direction A</p>
        <h2>Room</h2>
        <p>Four campus seats around one table.</p>
      </a>
      <a href="/map/">
        <p class="kicker">Direction B</p>
        <h2>Map</h2>
        <p>{{ site.yaleLine }}</p>
      </a>
      <a href="/table/">
        <p class="kicker">Direction C</p>
        <h2>Table</h2>
        <p>The docket on the cloth. Information is the service.</p>
      </a>
    </nav>
  </header>

  <section class="deck-sittings" aria-labelledby="sat-heading">
    <div class="section-head">
      <h2 id="sat-heading">Sat · <span class="tabular">{{ pastSittings.length }}</span></h2>
      <p class="legend">
        <span class="chip chip-owned">Owned</span>
        <span class="chip chip-co-hosted">Co-hosted</span>
        <span class="chip chip-listed">Listed</span>
        <span class="chip chip-inferred">Eligibility inferred</span>
      </p>
    </div>
    <div class="board board--dense">
      {% set compactSitting = true %}
      {% for sitting in pastSittings %}
        {% include "sitting.njk" %}
      {% endfor %}
    </div>
    <p class="section-more"><a class="text-link" href="/docket/">Full docket</a></p>
  </section>

  <aside class="deck-rail">
    <section class="rail-stats" aria-label="On the table">
      <a href="/docket/"><strong class="tabular">{{ pastSittings.length }}</strong><span>sittings sat</span></a>
      <a href="/offer-book/"><strong class="tabular">{{ offers.length }}</strong><span>live offers</span></a>
      <a href="/benefits/"><strong class="tabular">{{ benefits.length }}</strong><span>benefits</span></a>
      <a href="/brief/"><strong class="tabular">{{ wire.length }}</strong><span>wire posts</span></a>
    </section>

    {% set emptyTitle = "No sitting is on the docket yet." %}
    {% set emptyBody = "Upcoming always resolves. The past board is the substance." %}
    {% include "empty.njk" %}

    <section aria-labelledby="seats-heading">
      <h2 id="seats-heading">Campus seats</h2>
      <ul class="seats">
        {% for seat in programs %}
          {% include "seat-card.njk" %}
        {% endfor %}
      </ul>
    </section>
  </aside>

  <section class="deck-wire" aria-labelledby="wire-heading">
    <div class="section-head">
      <h2 id="wire-heading">Brief · <span class="tabular">{{ wire.length }}</span></h2>
      <p><a class="text-link" href="/brief/">Open the wire</a></p>
    </div>
    <div class="wire">
      <section>
        <h3 class="wire-lane">Industry · <span class="tabular">{{ industryWire.length }}</span></h3>
        {% for item in industryWire %}
        <article class="wire-item{% if item.held %} wire-held{% endif %}">
          <p class="meta">
            <time datetime="{{ item.publishedAt | isoDay }}">{{ item.publishedAt | isoDay }}</time>
            {% if item.held %}<span class="chip chip-held">Held</span>{% endif %}
            {% if item.inferred %}<span class="chip chip-inferred">Inferred</span>{% endif %}
          </p>
          <h3>
            {% if item.slug | hasBriefPage %}
            <a href="/brief/{{ item.slug }}/">{{ item.title }}</a>
            {% else %}
            {{ item.title }}
            {% endif %}
          </h3>
          <p>{{ item.summary }}</p>
        </article>
        {% endfor %}
      </section>
      <section>
        <h3 class="wire-lane">Campus · <span class="tabular">{{ campusWire.length }}</span></h3>
        {% for item in campusWire %}
        <article class="wire-item">
          <p class="meta"><time datetime="{{ item.publishedAt | isoDay }}">{{ item.publishedAt | isoDay }}</time></p>
          <h3>{{ item.title }}</h3>
          <p>{{ item.summary }}</p>
        </article>
        {% endfor %}
      </section>
    </div>
  </section>

  <section class="deck-offers" aria-labelledby="offers-heading">
    <div class="section-head">
      <h2 id="offers-heading">Offer book · <span class="tabular">{{ offers.length }}</span></h2>
      <p>Verified 2026-08-18. Ungated. <a class="text-link" href="/offer-book/">Open the book</a></p>
    </div>
    <div class="offer-grid offer-grid--home">
      {% for offer in offers %}
      <article class="offer-card">
        <p class="kicker">{{ offer.counterpart }}</p>
        <h3><a href="/offer-book/{{ offer.slug }}/">{{ offer.title }}</a></h3>
        <p class="offer-term">{{ offer.terms }}</p>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="deck-tiers" aria-labelledby="tiers-heading">
    <div class="section-head">
      <h2 id="tiers-heading">Time to value · <span class="tabular">{{ benefits.length }}</span></h2>
      <p><a class="text-link" href="/benefits/">Open the ledger</a></p>
    </div>
    <div class="tier-grid">
      {% for tier in benefitTiers %}
      <section class="tier-col">
        <h3>{{ tier.label }} · <span class="tabular">{{ tier.items.length }}</span></h3>
        <ul>
          {% for b in tier.items %}
          <li>
            <strong>{{ b.title }}</strong>
            <span>{{ b.terms }}</span>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    </div>
  </section>
</div>
