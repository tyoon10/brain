---
layout: layout.njk
title: Room
description: Homepage direction — the room.
section: Directions
permalink: /room/index.html
bodyClass: page-room
---

<p class="kicker">Direction A · not locked</p>
<h1>The room is the product.</h1>
<p class="lede">Four campus seats. One table. {{ site.yaleLine }}</p>

<div class="room-stage" aria-hidden="true">
  <div class="room-ring">
    {% for seat in programs %}
    <a class="room-chair room-chair--{{ loop.index }}" href="/seats/{{ seat.id }}/">
      <span class="swatch" data-seat="{{ seat.id }}"></span>
      {{ seat.shortName }}
    </a>
    {% endfor %}
    <div class="room-table">
      <p class="kicker">The table</p>
      <p>Roundtable</p>
    </div>
  </div>
</div>

<ul class="seats">
  {% for seat in programs %}
  <li>
    <span class="swatch" data-seat="{{ seat.id }}"></span>
    <div>
      <strong><a href="/seats/{{ seat.id }}/">{{ seat.shortName }}</a></strong>
      <span>{{ seat.name }}</span>
      <span>{{ seat.sittingFrom }}</span>
    </div>
  </li>
  {% endfor %}
</ul>

<p class="actions">
  <a class="btn" href="/docket/">Docket</a>
  <a class="btn btn-quiet" href="/map/">Map</a>
  <a class="btn btn-quiet" href="/table/">Table</a>
</p>
