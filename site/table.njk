<p class="kicker">Direction C · not locked</p>
<h1>The docket on the table.</h1>
<p class="lede">Information is the service. Upcoming is empty by design. The past board is populated.</p>

<div class="table-cloth">
  <section>
    <p class="kicker">Upcoming</p>
    {% if upcomingSittings.length == 0 %}
      {% set emptyTitle = "No sitting is on the docket yet." %}
      {% set emptyBody = "Upcoming always resolves. An empty upcoming list is a designed state." %}
      {% include "empty.njk" %}
    {% endif %}
  </section>
  <section>
    <p class="kicker">Sat</p>
    <ol class="docket-lines">
      {% for sitting in pastSittings %}
      <li>
        <a href="/docket/{{ sitting.slug }}/">
          <span class="meta">{{ sitting.startsAt | nyDay }} · {{ sitting.relation | relationLabel }}</span>
          <strong>{{ sitting.title }}</strong>
        </a>
      </li>
      {% endfor %}
    </ol>
  </section>
</div>

<p class="actions">
  <a class="btn" href="/docket/">Full docket</a>
  <a class="btn btn-quiet" href="/offer-book/">Offer book</a>
  <a class="btn btn-quiet" href="/brief/">Brief</a>
</p>
